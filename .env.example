# Database
DATABASE_URL=postgresql://tabletop:tabletop_dev@localhost:5432/tabletop_oracle
DATABASE_URL_ASYNC=postgresql+asyncpg://tabletop:tabletop_dev@localhost:5432/tabletop_oracle

# Auth — OAuth provider credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Auth — session and security
INITIAL_CURATOR_EMAILS=          # Comma-separated emails for initial curator accounts
FRONTEND_ORIGIN=http://localhost:4200
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
AUTH_SESSION_TIMEOUT_DAYS=30
SESSION_COOKIE_SECURE=false      # Set to true in production (requires HTTPS)
SECRET_KEY=change-me-in-production
BYPASS_AUTH=false                 # Set to true for local development without OAuth

# Storage
BLOB_STORAGE_BACKEND=local       # Options: local
BLOB_STORAGE_LOCAL_PATH=./storage

# Application
LOG_LEVEL=INFO
